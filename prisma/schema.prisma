generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id        String   @id @default(cuid())
  name      String
  gender    Gender
  createdAt DateTime @default(now())

  sessionPlayers SessionPlayer[]
  team1Game1     Game[]          @relation("Team1Player1")
  team1Game2     Game[]          @relation("Team1Player2")
  team2Game1     Game[]          @relation("Team2Player1")
  team2Game2     Game[]          @relation("Team2Player2")
  teamsAsPlayer1   Team[]           @relation("TeamPlayer1")
  teamsAsPlayer2   Team[]           @relation("TeamPlayer2")
  overridesAsP1    PlayerOverride[] @relation("OverridePlayer1")
  overridesAsP2    PlayerOverride[] @relation("OverridePlayer2")
}

model Session {
  id            String        @id @default(cuid())
  name          String?
  date          DateTime
  endTime       DateTime?
  sessionFormat  SessionFormat @default(ROTATING)
  hasMedalRound  Boolean       @default(false)
  hasDivisions   Boolean       @default(false)
  createdAt      DateTime      @default(now())

  courts          Court[]
  sessionPlayers  SessionPlayer[]
  teams           Team[]
  playerOverrides PlayerOverride[]
  medalRound      MedalRound?
  pods            Pod[]
}

model Pod {
  id        String @id @default(cuid())
  sessionId String
  name      String

  session        Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionPlayers SessionPlayer[]
  teams          Team[]
}

model MedalRound {
  id        String         @id @default(cuid())
  sessionId String         @unique
  type      MedalRoundType
  data      Json
  createdAt DateTime       @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model PlayerOverride {
  id        String       @id @default(cuid())
  sessionId String
  player1Id String
  player2Id String
  type      OverrideType

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player1 Player  @relation("OverridePlayer1", fields: [player1Id], references: [id])
  player2 Player  @relation("OverridePlayer2", fields: [player2Id], references: [id])

  @@unique([sessionId, player1Id, player2Id])
}

model Team {
  id        String  @id @default(cuid())
  sessionId String
  player1Id String
  player2Id String
  podId     String?

  session Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player1 Player   @relation("TeamPlayer1", fields: [player1Id], references: [id])
  player2 Player   @relation("TeamPlayer2", fields: [player2Id], references: [id])
  pod     Pod?     @relation(fields: [podId], references: [id], onDelete: SetNull)

  gamesAsTeam1 Game[] @relation("FixedTeam1")
  gamesAsTeam2 Game[] @relation("FixedTeam2")

  @@unique([sessionId, player1Id])
  @@unique([sessionId, player2Id])
}

model Court {
  id        String      @id @default(cuid())
  sessionId String
  number    Int
  format    CourtFormat

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  games   Game[]
}

model SessionPlayer {
  id        String    @id @default(cuid())
  sessionId String
  playerId  String
  courtId   String?
  podId     String?
  division  Division?

  session Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  pod     Pod?     @relation(fields: [podId], references: [id], onDelete: SetNull)

  @@unique([sessionId, playerId])
}

model Game {
  id             String   @id @default(cuid())
  courtId        String
  roundNumber    Int
  team1Player1Id String
  team1Player2Id String
  team2Player1Id String
  team2Player2Id String
  team1Id        String?
  team2Id        String?
  team1Score     Int?
  team2Score     Int?
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now())

  court        Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  team1Player1 Player @relation("Team1Player1", fields: [team1Player1Id], references: [id])
  team1Player2 Player @relation("Team1Player2", fields: [team1Player2Id], references: [id])
  team2Player1 Player @relation("Team2Player1", fields: [team2Player1Id], references: [id])
  team2Player2 Player @relation("Team2Player2", fields: [team2Player2Id], references: [id])
  fixedTeam1   Team?  @relation("FixedTeam1", fields: [team1Id], references: [id])
  fixedTeam2   Team?  @relation("FixedTeam2", fields: [team2Id], references: [id])
}

enum Gender {
  MALE
  FEMALE
}

enum Division {
  UPPER
  LOWER
}

enum CourtFormat {
  MIXED
  MENS
  WOMENS
  ANY
}

enum SessionFormat {
  ROTATING
  FIXED
}

enum OverrideType {
  MUST_PARTNER
  MUST_NOT_PARTNER
}

enum MedalRoundType {
  FIXED
  RANDOM
  SNAKE
}
